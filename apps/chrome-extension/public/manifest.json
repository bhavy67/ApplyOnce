{
  "manifest_version": 3,
  "name": "ApplyOnce",
  "version": "0.4.0",
  "description": "Local-first personal autofill for repetitive forms.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "ApplyOnce",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "profile.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
